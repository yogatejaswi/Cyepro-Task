{
  "name": "hyundai-automotive-assistant",
  "private": true,
  "engines": { "node": ">=22" },
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:server": "npm run start:dev -w @hyundai/server",
    "dev:client": "npm run dev -w @hyundai/client",
    "build": "npm run build -w @hyundai/server && npm run build -w @hyundai/client",
    "test": "npm run test -w @hyundai/server"
  }
}
