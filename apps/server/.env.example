PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/hyundai_assistant?retryWrites=true&w=majority
MONGODB_DNS_SERVERS=
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=onnx-community/all-MiniLM-L6-v2-ONNX
EMBEDDING_CACHE_DIR=
FRONTEND_URL=http://localhost:5173
VECTOR_INDEX_NAME=brochure_vector_index
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
